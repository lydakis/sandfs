"""Type stubs for the Rust extension module."""

import builtins
from os import PathLike
from typing import Literal, final

from .source import Source

Kind = Literal["file", "dir", "symlink"]
ChangeKind = Literal["added", "modified", "deleted"]

class VersionMismatch(Exception):
    path: str
    expected: int
    actual: int

@final
class DirEntry:
    def __init__(
        self,
        name: str,
        kind: Kind = "file",
        *,
        size: int | None = None,
        executable: bool = False,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> Kind: ...
    @property
    def size(self) -> int | None: ...
    @property
    def executable(self) -> bool: ...

@final
class Stat:
    @property
    def kind(self) -> Kind: ...
    @property
    def size(self) -> int: ...
    @property
    def version(self) -> int: ...
    @property
    def executable(self) -> bool: ...

@final
class Change:
    @property
    def path(self) -> str: ...
    @property
    def kind(self) -> ChangeKind: ...

@final
class DirSource:
    def __init__(self, root: str | PathLike[str]) -> None: ...

@final
class MemorySource:
    def __init__(self, files: dict[str, str | bytes]) -> None: ...

@final
class GitSource:
    def __init__(self, repo: str | PathLike[str], rev: str = "HEAD") -> None: ...

@final
class Workspace:
    def __init__(self) -> None: ...
    def mount(self, path: str, source: DirSource | MemorySource | GitSource | Source) -> None: ...
    def fork(self) -> Workspace: ...
    def exists(self, path: str) -> bool: ...
    def stat(self, path: str) -> Stat: ...
    def read(self, path: str, *, offset: int = 0, length: int | None = None) -> bytes: ...
    def read_text(self, path: str) -> str: ...
    def read_link(self, path: str) -> str: ...
    def symlink(self, path: str, target: str) -> int: ...
    def hard_link(self, src: str, dst: str) -> None: ...
    def hard_links(self, path: str) -> builtins.list[str]: ...
    def list(self, path: str = "/") -> builtins.list[DirEntry]: ...
    def write(
        self, path: str, data: str | bytes, *, expected_version: int | None = None
    ) -> int: ...
    def mkdir(self, path: str, *, parents: bool = False) -> None: ...
    def remove(self, path: str, *, recursive: bool = False) -> None: ...
    def copy(self, src: str, dst: str, *, recursive: bool = False) -> None: ...
    def move(self, src: str, dst: str) -> None: ...
    def changes(self) -> builtins.list[Change]: ...
