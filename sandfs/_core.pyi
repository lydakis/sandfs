"""Type stubs for the Rust extension module."""

import builtins
from collections.abc import Mapping
from os import PathLike
from typing import Literal, final

Kind = Literal["file", "dir", "symlink"]
ChangeKind = Literal["added", "modified", "deleted"]

class VersionMismatch(Exception):
    path: str
    expected: int
    actual: int

class EditFailed(ValueError): ...

@final
class DirEntry:
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> Kind: ...
    @property
    def size(self) -> int | None: ...
    @property
    def executable(self) -> bool: ...

@final
class Stat:
    @property
    def kind(self) -> Kind: ...
    @property
    def size(self) -> int | None: ...
    @property
    def version(self) -> int: ...
    @property
    def executable(self) -> bool: ...

@final
class Change:
    @property
    def path(self) -> str: ...
    @property
    def kind(self) -> ChangeKind: ...

@final
class Workspace:
    def __init__(self) -> None: ...
    def mount_git(self, path: str, repo: str | PathLike[str], rev: str = "HEAD") -> None: ...
    def mount_dir(self, path: str, root: str | PathLike[str]) -> None: ...
    def mount_files(self, path: str, files: Mapping[str, str | bytes]) -> None: ...
    def fork(self) -> Workspace: ...
    def exists(self, path: str) -> bool: ...
    def stat(self, path: str) -> Stat: ...
    def read(self, path: str) -> bytes: ...
    def read_text(self, path: str) -> str: ...
    def read_link(self, path: str) -> str: ...
    def list(self, path: str = "/") -> builtins.list[DirEntry]: ...
    def write(
        self, path: str, data: str | bytes, *, expected_version: int | None = None
    ) -> int: ...
    def edit(
        self,
        path: str,
        old: str,
        new: str,
        *,
        replace_all: bool = False,
        expected_version: int | None = None,
    ) -> int: ...
    def mkdir(self, path: str, *, parents: bool = False) -> None: ...
    def symlink(self, path: str, target: str) -> None: ...
    def remove(self, path: str, *, recursive: bool = False) -> None: ...
    def copy(self, src: str, dst: str, *, recursive: bool = False) -> None: ...
    def move(self, src: str, dst: str) -> None: ...
    def diff(self) -> builtins.list[Change]: ...
